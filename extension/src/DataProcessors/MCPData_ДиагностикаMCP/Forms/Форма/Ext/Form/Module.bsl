#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	ОбновитьДиагностикуНаСервере();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ОбновитьОбработчик(Команда)
	ОбновитьДиагностикуНаСервере();
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиОповещений

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура ОбновитьДиагностикуНаСервере()
	СистемнаяИнформация = Новый СистемнаяИнформация;
	ВерсияПлатформы = СистемнаяИнформация.ВерсияПриложения;
	ВерсияРасширения = "1.2.0";
	Пользователь = ТекущийПользовательБезопасно();
	ДоступныеОбъекты = КоличествоДоступныхОбъектов();

	Попытка
		Схема = Новый СхемаЗапроса;
		Схема.УстановитьТекстЗапроса("ВЫБРАТЬ 1 КАК Значение");
		Схема.ПолучитьТекстЗапроса();
		КомпиляцияЗапроса = "Успешно";
	Исключение
		КомпиляцияЗапроса = "Ошибка";
	КонецПопытки;

	РезультатДиагностики =
		"Расширение: MCP_DataAccess " + ВерсияРасширения + Символы.ПС
		+ "Платформа: " + ВерсияПлатформы + Символы.ПС
		+ "Пользователь 1С: " + Пользователь + Символы.ПС
		+ "Объектов метаданных с правом чтения: " + Строка(ДоступныеОбъекты) + Символы.ПС
		+ "Компиляция безопасного тестового запроса: " + КомпиляцияЗапроса + Символы.ПС
		+ "Привилегированный режим: не используется" + Символы.ПС
		+ "Доступ к ОС, паролям и внешним процессам: отсутствует";
КонецПроцедуры

&НаСервереБезКонтекста
Функция ТекущийПользовательБезопасно()
	Попытка
		Возврат ПользователиИнформационнойБазы.ТекущийПользователь().Имя;
	Исключение
		Возврат "Не определен";
	КонецПопытки;
КонецФункции

&НаСервереБезКонтекста
Функция КоличествоДоступныхОбъектов()
	Количество = 0;
	Количество = Количество + КоличествоДоступныхВКоллекции(Метаданные.Справочники);
	Количество = Количество + КоличествоДоступныхВКоллекции(Метаданные.Документы);
	Количество = Количество + КоличествоДоступныхВКоллекции(Метаданные.РегистрыСведений);
	Количество = Количество + КоличествоДоступныхВКоллекции(Метаданные.РегистрыНакопления);
	Количество = Количество + КоличествоДоступныхВКоллекции(Метаданные.РегистрыБухгалтерии);
	Количество = Количество + КоличествоДоступныхВКоллекции(Метаданные.РегистрыРасчета);
	Возврат Количество;
КонецФункции

&НаСервереБезКонтекста
Функция КоличествоДоступныхВКоллекции(КоллекцияМетаданных)
	Количество = 0;
	Для Каждого ОбъектМетаданных Из КоллекцияМетаданных Цикл
		Попытка
			Если ПравоДоступа("Чтение", ОбъектМетаданных) Тогда
				Количество = Количество + 1;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;
	Возврат Количество;
КонецФункции

#КонецОбласти
