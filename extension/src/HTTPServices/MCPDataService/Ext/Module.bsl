// MCP_DataAccess 1.2.0
// Отдельный HTTP-сервис только для чтения. Все операции выполняются
// с правами текущего пользователя 1С; привилегированный режим не используется.

Функция ПрочитатьТелоJSON(HTTPЗапрос)
	Чтение = Новый ЧтениеJSON;
	Чтение.УстановитьСтроку(HTTPЗапрос.ПолучитьТелоКакСтроку());
	Данные = ПрочитатьJSON(Чтение);
	Чтение.Закрыть();
	Возврат Данные;
КонецФункции

Функция ЗаписатьВJSON(Значение)
	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку();
	ЗаписатьJSON(Запись, Значение);
	Возврат Запись.Закрыть();
КонецФункции

Функция ОтветJSON(Значение, КодСостояния = 200)
	Ответ = Новый HTTPСервисОтвет(КодСостояния);
	Ответ.Заголовки.Вставить("Content-Type", "application/json; charset=utf-8");
	Ответ.Заголовки.Вставить("Cache-Control", "no-store");
	Ответ.Заголовки.Вставить("X-Content-Type-Options", "nosniff");
	Ответ.УстановитьТелоИзСтроки(ЗаписатьВJSON(Значение));
	Возврат Ответ;
КонецФункции

Функция ОтветОшибка(КодСостояния, КодОшибки, Сообщение)
	Ошибка = Новый Структура;
	Ошибка.Вставить("code", КодОшибки);
	Ошибка.Вставить("message", Сообщение);
	Конверт = Новый Структура;
	Конверт.Вставить("error", Ошибка);
	Возврат ОтветJSON(Конверт, КодСостояния);
КонецФункции

Функция СвойствоДоступно(Объект, ИмяСвойства)
	Попытка
		Значение = Объект[ИмяСвойства];
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

Функция ПользовательМожетЧитать(ОбъектМетаданных)
	Попытка
		Возврат ПравоДоступа("Чтение", ОбъектМетаданных);
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

Функция КоллекцииЗапросов()
	Результат = Новый Массив;
	Результат.Добавить(Новый Структура("type,collection,prefix", "Catalog", "Справочники", "Справочник"));
	Результат.Добавить(Новый Структура("type,collection,prefix", "Document", "Документы", "Документ"));
	Результат.Добавить(Новый Структура("type,collection,prefix", "Enum", "Перечисления", "Перечисление"));
	Результат.Добавить(Новый Структура("type,collection,prefix", "InformationRegister", "РегистрыСведений", "РегистрСведений"));
	Результат.Добавить(Новый Структура("type,collection,prefix", "AccumulationRegister", "РегистрыНакопления", "РегистрНакопления"));
	Результат.Добавить(Новый Структура("type,collection,prefix", "AccountingRegister", "РегистрыБухгалтерии", "РегистрБухгалтерии"));
	Результат.Добавить(Новый Структура("type,collection,prefix", "CalculationRegister", "РегистрыРасчета", "РегистрРасчета"));
	Результат.Добавить(Новый Структура("type,collection,prefix", "ChartOfAccounts", "ПланыСчетов", "ПланСчетов"));
	Результат.Добавить(Новый Структура("type,collection,prefix", "ChartOfCharacteristicTypes", "ПланыВидовХарактеристик", "ПланВидовХарактеристик"));
	Результат.Добавить(Новый Структура("type,collection,prefix", "ChartOfCalculationTypes", "ПланыВидовРасчета", "ПланВидовРасчета"));
	Результат.Добавить(Новый Структура("type,collection,prefix", "ExchangePlan", "ПланыОбмена", "ПланОбмена"));
	Результат.Добавить(Новый Структура("type,collection,prefix", "BusinessProcess", "БизнесПроцессы", "БизнесПроцесс"));
	Результат.Добавить(Новый Структура("type,collection,prefix", "Task", "Задачи", "Задача"));
	Результат.Добавить(Новый Структура("type,collection,prefix", "DocumentJournal", "ЖурналыДокументов", "ЖурналДокументов"));
	Возврат Результат;
КонецФункции

Функция НайтиОписаниеКоллекции(ТипОбъекта)
	Для Каждого Описание Из КоллекцииЗапросов() Цикл
		Если Описание.type = ТипОбъекта Тогда
			Возврат Описание;
		КонецЕсли;
	КонецЦикла;
	Возврат Неопределено;
КонецФункции

Функция НайтиОбъектМетаданных(ТипОбъекта, ИмяОбъекта)
	Описание = НайтиОписаниеКоллекции(ТипОбъекта);
	Если Описание = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	Попытка
		Возврат Метаданные[Описание.collection].Найти(ИмяОбъекта);
	Исключение
		Возврат Неопределено;
	КонецПопытки;
КонецФункции

Функция ИнформацияGET(HTTPЗапрос)
	Результат = Новый Структура;
	Результат.Вставить("configuration", Метаданные.Имя);
	Результат.Вставить("version", Метаданные.Версия);
	СистемнаяИнформация = Новый СистемнаяИнформация;
	Результат.Вставить("platform_version", СистемнаяИнформация.ВерсияПриложения);
	ИмяПользователя = "";
	Попытка
		ИмяПользователя = ПользователиИнформационнойБазы.ТекущийПользователь().Имя;
	Исключение
	КонецПопытки;
	Результат.Вставить("user", ИмяПользователя);
	Результат.Вставить("read_only", Истина);
	Результат.Вставить("extension_version", "1.2.0");
	Возврат ОтветJSON(Результат);
КонецФункции

Функция ПолучитьИменаПолейДляПоиска(ОбъектМетаданных)
	Результат = Новый Массив;
	Имена = Новый Соответствие;
	КоллекцииПолей = Новый Массив;
	КоллекцииПолей.Добавить("Реквизиты");
	КоллекцииПолей.Добавить("Измерения");
	КоллекцииПолей.Добавить("Ресурсы");
	Для Каждого ИмяКоллекции Из КоллекцииПолей Цикл
		Если НЕ СвойствоДоступно(ОбъектМетаданных, ИмяКоллекции) Тогда
			Продолжить;
		КонецЕсли;
		Для Каждого ПолеМетаданных Из ОбъектМетаданных[ИмяКоллекции] Цикл
			Если Имена.Получить(ПолеМетаданных.Имя) = Неопределено Тогда
				Имена.Вставить(ПолеМетаданных.Имя, Истина);
				Результат.Добавить(ПолеМетаданных.Имя);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция МетаданныеGET(HTTPЗапрос)
	Объекты = Новый Массив;
	Для Каждого ОписаниеКоллекции Из КоллекцииЗапросов() Цикл
		Попытка
			Коллекция = Метаданные[ОписаниеКоллекции.collection];
			Для Каждого ОбъектМетаданных Из Коллекция Цикл
				Если НЕ ПользовательМожетЧитать(ОбъектМетаданных) Тогда
					Продолжить;
				КонецЕсли;
				ОписаниеОбъекта = Новый Структура;
				ОписаниеОбъекта.Вставить("type", ОписаниеКоллекции.type);
				ОписаниеОбъекта.Вставить("name", ОбъектМетаданных.Имя);
				ОписаниеОбъекта.Вставить("synonym", Строка(ОбъектМетаданных.Синоним));
				ОписаниеОбъекта.Вставить("query_source", ОписаниеКоллекции.prefix + "." + ОбъектМетаданных.Имя);
				ОписаниеОбъекта.Вставить("can_read", Истина);
				ОписаниеОбъекта.Вставить("fields", ПолучитьИменаПолейДляПоиска(ОбъектМетаданных));
				Объекты.Добавить(ОписаниеОбъекта);
			КонецЦикла;
		Исключение
			// Неподдерживаемая коллекция не раскрывается диагностикой наружу.
		КонецПопытки;
	КонецЦикла;
	Результат = Новый Структура;
	Результат.Вставить("configuration", Метаданные.Имя);
	Результат.Вставить("version", Метаданные.Версия);
	Результат.Вставить("objects", Объекты);
	Возврат ОтветJSON(Результат);
КонецФункции

Процедура ДобавитьПоле(Поля, Имя, Синоним, ТипПоля)
	Поле = Новый Структура;
	Поле.Вставить("name", Имя);
	Поле.Вставить("synonym", Синоним);
	Поле.Вставить("type", ТипПоля);
	Поля.Добавить(Поле);
КонецПроцедуры

Процедура ДобавитьСтандартныеПоля(Поля, ТипОбъекта, ОбъектМетаданных)
	Если ТипОбъекта = "Catalog" Тогда
		ДобавитьПоле(Поля, "Ссылка", "Ссылка", "CatalogRef." + ОбъектМетаданных.Имя);
		ДобавитьПоле(Поля, "ПометкаУдаления", "Пометка удаления", "Boolean");
		ДобавитьПоле(Поля, "Предопределенный", "Предопределенный", "Boolean");
		Попытка
			Если ОбъектМетаданных.ДлинаКода > 0 Тогда
				ДобавитьПоле(Поля, "Код", "Код", "String");
			КонецЕсли;
		Исключение
		КонецПопытки;
		Попытка
			Если ОбъектМетаданных.ДлинаНаименования > 0 Тогда
				ДобавитьПоле(Поля, "Наименование", "Наименование", "String");
			КонецЕсли;
		Исключение
		КонецПопытки;
		Попытка
			Если ОбъектМетаданных.Иерархический Тогда
				ДобавитьПоле(Поля, "ЭтоГруппа", "Это группа", "Boolean");
				ДобавитьПоле(Поля, "Родитель", "Родитель", "CatalogRef." + ОбъектМетаданных.Имя);
			КонецЕсли;
		Исключение
		КонецПопытки;
	ИначеЕсли ТипОбъекта = "Document" Тогда
		ДобавитьПоле(Поля, "Ссылка", "Ссылка", "DocumentRef." + ОбъектМетаданных.Имя);
		ДобавитьПоле(Поля, "ПометкаУдаления", "Пометка удаления", "Boolean");
		ДобавитьПоле(Поля, "Номер", "Номер", "String");
		ДобавитьПоле(Поля, "Дата", "Дата", "Date");
		ДобавитьПоле(Поля, "Проведен", "Проведен", "Boolean");
	ИначеЕсли ТипОбъекта = "DocumentJournal" Тогда
		ДобавитьПоле(Поля, "Ссылка", "Ссылка", "DocumentRef");
		ДобавитьПоле(Поля, "ПометкаУдаления", "Пометка удаления", "Boolean");
		ДобавитьПоле(Поля, "Номер", "Номер", "String");
		ДобавитьПоле(Поля, "Дата", "Дата", "Date");
		ДобавитьПоле(Поля, "Проведен", "Проведен", "Boolean");
	ИначеЕсли ТипОбъекта = "Enum" Тогда
		ДобавитьПоле(Поля, "Ссылка", "Значение перечисления", "EnumRef." + ОбъектМетаданных.Имя);
		ДобавитьПоле(Поля, "Порядок", "Порядок", "Number");
	ИначеЕсли ТипОбъекта = "InformationRegister" Тогда
		Попытка
			Если Строка(ОбъектМетаданных.Периодичность) <> "Непериодический" Тогда
				ДобавитьПоле(Поля, "Период", "Период", "Date");
			КонецЕсли;
		Исключение
		КонецПопытки;
		Попытка
			Если СтрНайти(Строка(ОбъектМетаданных.РежимЗаписи), "Регистратор") > 0 Тогда
				ДобавитьПоле(Поля, "Регистратор", "Регистратор", "DocumentRef");
				ДобавитьПоле(Поля, "НомерСтроки", "Номер строки", "Number");
				ДобавитьПоле(Поля, "Активность", "Активность", "Boolean");
			КонецЕсли;
		Исключение
		КонецПопытки;
	ИначеЕсли ТипОбъекта = "AccumulationRegister"
		ИЛИ ТипОбъекта = "AccountingRegister"
		ИЛИ ТипОбъекта = "CalculationRegister" Тогда
		ДобавитьПоле(Поля, "Период", "Период", "Date");
		ДобавитьПоле(Поля, "Регистратор", "Регистратор", "DocumentRef");
		ДобавитьПоле(Поля, "НомерСтроки", "Номер строки", "Number");
		ДобавитьПоле(Поля, "Активность", "Активность", "Boolean");
	ИначеЕсли ТипОбъекта = "BusinessProcess" ИЛИ ТипОбъекта = "Task" Тогда
		ДобавитьПоле(Поля, "Ссылка", "Ссылка", ТипОбъекта + "Ref." + ОбъектМетаданных.Имя);
		ДобавитьПоле(Поля, "ПометкаУдаления", "Пометка удаления", "Boolean");
		ДобавитьПоле(Поля, "Номер", "Номер", "String");
		ДобавитьПоле(Поля, "Дата", "Дата", "Date");
	КонецЕсли;
КонецПроцедуры

Процедура ДобавитьКоллекциюПолей(Поля, ОбъектМетаданных, ИмяКоллекции)
	Если НЕ СвойствоДоступно(ОбъектМетаданных, ИмяКоллекции) Тогда
		Возврат;
	КонецЕсли;
	Для Каждого ЭлементМетаданных Из ОбъектМетаданных[ИмяКоллекции] Цикл
		ДобавитьПоле(Поля, ЭлементМетаданных.Имя, Строка(ЭлементМетаданных.Синоним), Строка(ЭлементМетаданных.Тип));
	КонецЦикла;
КонецПроцедуры

Функция ПолучитьТабличныеЧасти(ОбъектМетаданных, ИсточникЗапроса)
	Результат = Новый Массив;
	Если НЕ СвойствоДоступно(ОбъектМетаданных, "ТабличныеЧасти") Тогда
		Возврат Результат;
	КонецЕсли;
	Для Каждого ТабличнаяЧасть Из ОбъектМетаданных.ТабличныеЧасти Цикл
		Описание = Новый Структура;
		Описание.Вставить("name", ТабличнаяЧасть.Имя);
		Описание.Вставить("synonym", Строка(ТабличнаяЧасть.Синоним));
		Описание.Вставить("query_source", ИсточникЗапроса + "." + ТабличнаяЧасть.Имя);
		Поля = Новый Массив;
		ДобавитьПоле(Поля, "Ссылка", "Ссылка владельца", "Reference");
		ДобавитьПоле(Поля, "НомерСтроки", "Номер строки", "Number");
		ДобавитьКоллекциюПолей(Поля, ТабличнаяЧасть, "Реквизиты");
		Описание.Вставить("fields", Поля);
		Результат.Добавить(Описание);
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция ПолучитьВиртуальныеТаблицы(ТипОбъекта, ОбъектМетаданных, ИсточникЗапроса)
	Результат = Новый Массив;
	Если ТипОбъекта = "InformationRegister" Тогда
		ЭтоПериодический = Ложь;
		Попытка
			ЭтоПериодический = Строка(ОбъектМетаданных.Периодичность) <> "Непериодический";
		Исключение
		КонецПопытки;
		Если ЭтоПериодический Тогда
			ПоляСреза = ПолучитьПоляВиртуальнойТаблицы(ОбъектМетаданных, "Срез");
			ДобавитьВиртуальнуюТаблицу(Результат, "СрезПоследних", ИсточникЗапроса + ".СрезПоследних", ПоляСреза);
			ДобавитьВиртуальнуюТаблицу(Результат, "СрезПервых", ИсточникЗапроса + ".СрезПервых", ПоляСреза);
		КонецЕсли;
	ИначеЕсли ТипОбъекта = "AccumulationRegister" Тогда
		ДобавитьВиртуальнуюТаблицу(Результат, "Обороты", ИсточникЗапроса + ".Обороты",
			ПолучитьПоляВиртуальнойТаблицы(ОбъектМетаданных, "Обороты"));
		Попытка
			Если Строка(ОбъектМетаданных.ВидРегистра) <> "Обороты" Тогда
				ДобавитьВиртуальнуюТаблицу(Результат, "Остатки", ИсточникЗапроса + ".Остатки",
					ПолучитьПоляВиртуальнойТаблицы(ОбъектМетаданных, "Остатки"));
				ДобавитьВиртуальнуюТаблицу(Результат, "ОстаткиИОбороты", ИсточникЗапроса + ".ОстаткиИОбороты",
					ПолучитьПоляВиртуальнойТаблицы(ОбъектМетаданных, "ОстаткиИОбороты"));
			КонецЕсли;
		Исключение
		КонецПопытки;
	ИначеЕсли ТипОбъекта = "AccountingRegister" Тогда
		// Для бухгалтерских регистров состав колонок зависит от плана счетов
		// и субконто. Пустой список полей явно означает динамическую схему;
		// окончательный состав проверяется компилятором запроса 1С.
		ДобавитьВиртуальнуюТаблицу(Результат, "Обороты", ИсточникЗапроса + ".Обороты", Новый Массив);
		ДобавитьВиртуальнуюТаблицу(Результат, "Остатки", ИсточникЗапроса + ".Остатки", Новый Массив);
		ДобавитьВиртуальнуюТаблицу(Результат, "ОстаткиИОбороты", ИсточникЗапроса + ".ОстаткиИОбороты", Новый Массив);
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ПолучитьПоляВиртуальнойТаблицы(ОбъектМетаданных, Режим)
	Поля = Новый Массив;
	ДобавитьКоллекциюПолей(Поля, ОбъектМетаданных, "Измерения");
	Если Режим = "Срез" Тогда
		ДобавитьПоле(Поля, "Период", "Период", "Date");
		ДобавитьКоллекциюПолей(Поля, ОбъектМетаданных, "Ресурсы");
		ДобавитьКоллекциюПолей(Поля, ОбъектМетаданных, "Реквизиты");
		Возврат Поля;
	КонецЕсли;
	Если Режим = "Обороты" ИЛИ Режим = "ОстаткиИОбороты" Тогда
		ДобавитьПоле(Поля, "Период", "Период", "Date");
	КонецЕсли;
	Если СвойствоДоступно(ОбъектМетаданных, "Ресурсы") Тогда
		Для Каждого Ресурс Из ОбъектМетаданных.Ресурсы Цикл
			Если Режим = "Обороты" Тогда
				ДобавитьПоле(Поля, Ресурс.Имя + "Оборот", Строка(Ресурс.Синоним) + " оборот", Строка(Ресурс.Тип));
			ИначеЕсли Режим = "Остатки" Тогда
				ДобавитьПоле(Поля, Ресурс.Имя + "Остаток", Строка(Ресурс.Синоним) + " остаток", Строка(Ресурс.Тип));
			ИначеЕсли Режим = "ОстаткиИОбороты" Тогда
				ДобавитьПоле(Поля, Ресурс.Имя + "НачальныйОстаток", Строка(Ресурс.Синоним) + " начальный остаток", Строка(Ресурс.Тип));
				ДобавитьПоле(Поля, Ресурс.Имя + "КонечныйОстаток", Строка(Ресурс.Синоним) + " конечный остаток", Строка(Ресурс.Тип));
				ДобавитьПоле(Поля, Ресурс.Имя + "Оборот", Строка(Ресурс.Синоним) + " оборот", Строка(Ресурс.Тип));
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Возврат Поля;
КонецФункции

Процедура ДобавитьВиртуальнуюТаблицу(МассивТаблиц, Имя, Источник, Поля)
	Описание = Новый Структура;
	Описание.Вставить("name", Имя);
	Описание.Вставить("query_source", Источник);
	Описание.Вставить("fields", Поля);
	МассивТаблиц.Добавить(Описание);
КонецПроцедуры

Функция ОписатьОбъект(ТипОбъекта, ИмяОбъекта)
	ОбъектМетаданных = НайтиОбъектМетаданных(ТипОбъекта, ИмяОбъекта);
	Если ОбъектМетаданных = Неопределено ИЛИ НЕ ПользовательМожетЧитать(ОбъектМетаданных) Тогда
		Возврат Неопределено;
	КонецЕсли;
	ОписаниеКоллекции = НайтиОписаниеКоллекции(ТипОбъекта);
	ИсточникЗапроса = ОписаниеКоллекции.prefix + "." + ИмяОбъекта;
	Поля = Новый Массив;
	ДобавитьСтандартныеПоля(Поля, ТипОбъекта, ОбъектМетаданных);
	ДобавитьКоллекциюПолей(Поля, ОбъектМетаданных, "Реквизиты");
	ДобавитьКоллекциюПолей(Поля, ОбъектМетаданных, "Измерения");
	ДобавитьКоллекциюПолей(Поля, ОбъектМетаданных, "Ресурсы");
	Если ТипОбъекта = "Enum" И СвойствоДоступно(ОбъектМетаданных, "ЗначенияПеречисления") Тогда
		Для Каждого ЗначениеПеречисления Из ОбъектМетаданных.ЗначенияПеречисления Цикл
			ДобавитьПоле(Поля, ЗначениеПеречисления.Имя, Строка(ЗначениеПеречисления.Синоним), "EnumValue");
		КонецЦикла;
	КонецЕсли;
	Результат = Новый Структура;
	Результат.Вставить("type", ТипОбъекта);
	Результат.Вставить("name", ИмяОбъекта);
	Результат.Вставить("synonym", Строка(ОбъектМетаданных.Синоним));
	Результат.Вставить("query_source", ИсточникЗапроса);
	Результат.Вставить("fields", Поля);
	Результат.Вставить("table_parts", ПолучитьТабличныеЧасти(ОбъектМетаданных, ИсточникЗапроса));
	Результат.Вставить("virtual_tables", ПолучитьВиртуальныеТаблицы(ТипОбъекта, ОбъектМетаданных, ИсточникЗапроса));
	Возврат Результат;
КонецФункции

Функция СхемаPOST(HTTPЗапрос)
	Попытка
		Параметры = ПрочитатьТелоJSON(HTTPЗапрос);
	Исключение
		Возврат ОтветОшибка(400, "INVALID_JSON", "Request body must be valid JSON.");
	КонецПопытки;
	Если НЕ Параметры.Свойство("objects") ИЛИ ТипЗнч(Параметры.objects) <> Тип("Массив") Тогда
		Возврат ОтветОшибка(400, "SCHEMA_OBJECTS_INVALID", "objects array is required.");
	КонецЕсли;
	Если Параметры.objects.Количество() < 1 ИЛИ Параметры.objects.Количество() > 10 Тогда
		Возврат ОтветОшибка(400, "SCHEMA_OBJECTS_INVALID", "Provide 1 to 10 objects.");
	КонецЕсли;
	Объекты = Новый Массив;
	Для Каждого СсылкаНаОбъект Из Параметры.objects Цикл
		Если НЕ СсылкаНаОбъект.Свойство("type") ИЛИ НЕ СсылкаНаОбъект.Свойство("name") Тогда
			Возврат ОтветОшибка(400, "SCHEMA_OBJECT_INVALID", "Each object requires type and name.");
		КонецЕсли;
		Описание = ОписатьОбъект(СсылкаНаОбъект.type, СсылкаНаОбъект.name);
		Если Описание = Неопределено Тогда
			Возврат ОтветОшибка(403, "SCHEMA_OBJECT_FORBIDDEN", "Object is absent or not readable.");
		КонецЕсли;
		Объекты.Добавить(Описание);
	КонецЦикла;
	Возврат ОтветJSON(Новый Структура("objects", Объекты));
КонецФункции

Функция ПроверкаЗапросаPOST(HTTPЗапрос)
	Попытка
		Параметры = ПрочитатьТелоJSON(HTTPЗапрос);
	Исключение
		Возврат ОтветОшибка(400, "INVALID_JSON", "Request body must be valid JSON.");
	КонецПопытки;
	Если НЕ Параметры.Свойство("query") ИЛИ ПустаяСтрока(Параметры.query) Тогда
		Возврат ОтветОшибка(400, "QUERY_EMPTY", "query is required.");
	КонецЕсли;
	Результат = Новый Структура;
	Попытка
		СхемаЗапроса = Новый СхемаЗапроса;
		СхемаЗапроса.УстановитьТекстЗапроса(Параметры.query);
		СхемаЗапроса.ПолучитьТекстЗапроса();
		Результат.Вставить("valid", Истина);
		Результат.Вставить("columns", Новый Массив);
		Результат.Вставить("warnings", Новый Массив);
	Исключение
		Результат.Вставить("valid", Ложь);
		Результат.Вставить("error_code", "QUERY_COMPILE_FAILED");
		ТекстОшибки = СокрЛП(ОписаниеОшибки());
		ТекстОшибки = СтрЗаменить(ТекстОшибки, Символы.ПС, " ");
		ТекстОшибки = СтрЗаменить(ТекстОшибки, Символы.ВК, " ");
		ТекстОшибки = СтрЗаменить(ТекстОшибки, Символы.Таб, " ");
		ПозицияСообщенияКомпилятора = СтрНайти(ТекстОшибки, "{(");
		Если ПозицияСообщенияКомпилятора > 0 Тогда
			ТекстОшибки = Сред(ТекстОшибки, ПозицияСообщенияКомпилятора);
		КонецЕсли;
		Если СтрДлина(ТекстОшибки) > 500 Тогда
			ТекстОшибки = Лев(ТекстОшибки, 500);
		КонецЕсли;
		Если ПустаяСтрока(ТекстОшибки) Тогда
			ТекстОшибки = "1C could not compile the query.";
		КонецЕсли;
		Результат.Вставить("error", ТекстОшибки);
	КонецПопытки;
	Возврат ОтветJSON(Результат);
КонецФункции

Функция ПреобразоватьПараметр(Описание)
	ТипПараметра = НРег(Описание.type);
	Если ТипПараметра = "string" ИЛИ ТипПараметра = "number" ИЛИ ТипПараметра = "boolean" Тогда
		Возврат Описание.value;
	ИначеЕсли ТипПараметра = "date" ИЛИ ТипПараметра = "datetime" Тогда
		Возврат XMLЗначение(Тип("Дата"), Описание.value);
	ИначеЕсли ТипПараметра = "null" Тогда
		Возврат Неопределено;
	ИначеЕсли ТипПараметра = "reference" Тогда
		Части = СтрРазделить(Описание.metadata, ".");
		Если Части.Количество() <> 2 Тогда
			ВызватьИсключение "Invalid reference metadata";
		КонецЕсли;
		Идентификатор = Новый УникальныйИдентификатор(Описание.uuid);
		Если Части[0] = "Catalog" Тогда
			Возврат Справочники[Части[1]].ПолучитьСсылку(Идентификатор);
		ИначеЕсли Части[0] = "Document" Тогда
			Возврат Документы[Части[1]].ПолучитьСсылку(Идентификатор);
		ИначеЕсли Части[0] = "BusinessProcess" Тогда
			Возврат БизнесПроцессы[Части[1]].ПолучитьСсылку(Идентификатор);
		ИначеЕсли Части[0] = "Task" Тогда
			Возврат Задачи[Части[1]].ПолучитьСсылку(Идентификатор);
		ИначеЕсли Части[0] = "ChartOfAccounts" Тогда
			Возврат ПланыСчетов[Части[1]].ПолучитьСсылку(Идентификатор);
		ИначеЕсли Части[0] = "ChartOfCharacteristicTypes" Тогда
			Возврат ПланыВидовХарактеристик[Части[1]].ПолучитьСсылку(Идентификатор);
		ИначеЕсли Части[0] = "ChartOfCalculationTypes" Тогда
			Возврат ПланыВидовРасчета[Части[1]].ПолучитьСсылку(Идентификатор);
		ИначеЕсли Части[0] = "ExchangePlan" Тогда
			Возврат ПланыОбмена[Части[1]].ПолучитьСсылку(Идентификатор);
		КонецЕсли;
		ВызватьИсключение "Unsupported reference type";
	ИначеЕсли ТипПараметра = "enum" Тогда
		Части = СтрРазделить(Описание.metadata, ".");
		Если Части.Количество() <> 2 ИЛИ Части[0] <> "Enum" Тогда
			ВызватьИсключение "Invalid enum metadata";
		КонецЕсли;
		Возврат Перечисления[Части[1]][Описание.value];
	КонецЕсли;
	ВызватьИсключение "Unsupported parameter type";
КонецФункции

Функция ИмяМетаданныхЗначения(Значение)
	Попытка
		ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗнч(Значение));
		Если ОбъектМетаданных = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		Возврат Строка(ОбъектМетаданных.ПолноеИмя());
	Исключение
		Возврат "";
	КонецПопытки;
КонецФункции

Функция ПривестиЗначениеКJSON(Значение)
	Если Значение = Неопределено ИЛИ Значение = NULL Тогда
		Возврат Неопределено;
	КонецЕсли;
	ТипЗначения = ТипЗнч(Значение);
	Если ТипЗначения = Тип("Строка") ИЛИ ТипЗначения = Тип("Число") ИЛИ ТипЗначения = Тип("Булево") Тогда
		Возврат Значение;
	ИначеЕсли ТипЗначения = Тип("Дата") Тогда
		Результат = Новый Структура;
		Результат.Вставить("kind", "date");
		Результат.Вставить("value", XMLСтрока(Значение));
		Возврат Результат;
	КонецЕсли;
	Попытка
		Идентификатор = Значение.УникальныйИдентификатор();
		Результат = Новый Структура;
		Результат.Вставить("kind", "reference");
		Результат.Вставить("metadata", ИмяМетаданныхЗначения(Значение));
		Результат.Вставить("uuid", Строка(Идентификатор));
		Результат.Вставить("presentation", Строка(Значение));
		Возврат Результат;
	Исключение
	КонецПопытки;
	ИмяМетаданных = ИмяМетаданныхЗначения(Значение);
	Если НЕ ПустаяСтрока(ИмяМетаданных) Тогда
		Результат = Новый Структура;
		Результат.Вставить("kind", "enum");
		Результат.Вставить("metadata", ИмяМетаданных);
		Результат.Вставить("value", Строка(Значение));
		Результат.Вставить("presentation", Строка(Значение));
		Возврат Результат;
	КонецЕсли;
	Результат = Новый Структура;
	Результат.Вставить("kind", "presentation");
	Результат.Вставить("value", Строка(Значение));
	Результат.Вставить("type", Строка(ТипЗначения));
	Возврат Результат;
КонецФункции

Процедура ПроверитьБюджетПоследнихДокументов(НачалоВыполнения)
	Если (ТекущаяДата() - НачалоВыполнения) >= 20 Тогда
		ВызватьИсключение "LATEST_DOCUMENT_TIMEOUT";
	КонецЕсли;
КонецПроцедуры



Функция ВыполнитьЗапросПоследнихДокументов(ИсточникЗапроса, Лимит, МаксимальнаяДата, ИспользоватьПолеНомер, ИспользоватьПолеПроведен)
	ПредставлениеНомер = ?(ИспользоватьПолеНомер, "Источник.Номер", Символ(34) + Символ(34));
	ПредставлениеПроведен = ?(ИспользоватьПолеПроведен, "Источник.Проведен", "ЛОЖЬ");
	ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ " + Формат(Лимит, "ЧГ=0") + Символы.ПС
		+ " Источник.Ссылка КАК Ссылка," + Символы.ПС
		+ " " + ПредставлениеНомер + " КАК Номер," + Символы.ПС
		+ " Источник.Дата КАК Дата," + Символы.ПС
		+ " " + ПредставлениеПроведен + " КАК Проведен," + Символы.ПС
		+ " Источник.ПометкаУдаления КАК ПометкаУдаления" + Символы.ПС
		+ "ИЗ " + ИсточникЗапроса + " КАК Источник" + Символы.ПС
		+ "ГДЕ НЕ Источник.ПометкаУдаления";
	Если МаксимальнаяДата <> Неопределено Тогда
		ТекстЗапроса = ТекстЗапроса + Символы.ПС + " И Источник.Дата = &МаксимальнаяДата";
	КонецЕсли;
	ТекстЗапроса = ТекстЗапроса + Символы.ПС + "УПОРЯДОЧИТЬ ПО Источник.Дата УБЫВ";
	Запрос1С = Новый Запрос(ТекстЗапроса);
	Если МаксимальнаяДата <> Неопределено Тогда
		Запрос1С.УстановитьПараметр("МаксимальнаяДата", МаксимальнаяДата);
	КонецЕсли;
	Возврат Запрос1С.Выполнить().Выгрузить();
КонецФункции

Функция ПолучитьСтрокиПоследнихДокументов(ИсточникЗапроса, Лимит, МаксимальнаяДата = Неопределено)
	Попытка
		Возврат ВыполнитьЗапросПоследнихДокументов(ИсточникЗапроса, Лимит, МаксимальнаяДата, Истина, Истина);
	Исключение
		Попытка
			// У некоторых служебных видов документов отсутствует стандартное поле Номер.
			Возврат ВыполнитьЗапросПоследнихДокументов(ИсточникЗапроса, Лимит, МаксимальнаяДата, Ложь, Истина);
		Исключение
			Попытка
				// У непроводимых видов документов физическое поле Проведен может отсутствовать.
				Возврат ВыполнитьЗапросПоследнихДокументов(ИсточникЗапроса, Лимит, МаксимальнаяДата, Истина, Ложь);
			Исключение
				// Меняются только необязательные общие поля; ошибки доступа и RLS останутся ошибками.
				Возврат ВыполнитьЗапросПоследнихДокументов(ИсточникЗапроса, Лимит, МаксимальнаяДата, Ложь, Ложь);
			КонецПопытки;
		КонецПопытки;
	КонецПопытки;
КонецФункции

Функция ДоступныеДокументыДляПоследнего()
	Результат = Новый Соответствие;
	Для Каждого ДокументМетаданных Из Метаданные.Документы Цикл
		Если ПользовательМожетЧитать(ДокументМетаданных) Тогда
			Результат.Вставить(ДокументМетаданных.Имя, ДокументМетаданных);
		КонецЕсли;
	КонецЦикла;
	Возврат Результат;
КонецФункции

Функция НепокрытыеДокументыЖурнала(ЖурналМетаданных, ДоступныеДокументы, ПокрытыеДокументы)
	Результат = Новый Массив;
	Попытка
		Для Каждого ДокументМетаданных Из ЖурналМетаданных.РегистрируемыеДокументы Цикл
			ИмяДокумента = ДокументМетаданных.Имя;
			Если ДоступныеДокументы.Получить(ИмяДокумента) <> Неопределено
				И ПокрытыеДокументы.Получить(ИмяДокумента) = Неопределено Тогда
				Результат.Добавить(ИмяДокумента);
			КонецЕсли;
		КонецЦикла;
	Исключение
		// Если платформа не раскрыла состав журнала, документы останутся для индивидуальной проверки.
	КонецПопытки;
	Возврат Результат;
КонецФункции

Процедура ЗарегистрироватьИсточникПоиска(Источники, ВидИсточника, ИсточникЗапроса, ИменаДокументов, Строки)
	Источник = Новый Структура;
	Источник.Вставить("kind", ВидИсточника);
	Источник.Вставить("query_source", ИсточникЗапроса);
	Источник.Вставить("documents", ИменаДокументов);
	Если Строки.Количество() = 0 Тогда
		Источник.Вставить("top_date", Неопределено);
	Иначе
		Источник.Вставить("top_date", Строки[0].Дата);
	КонецЕсли;
	Источники.Добавить(Источник);
КонецПроцедуры

Функция ОписатьПоследнийДокумент(СтрокаДокумента)
	ОбъектМетаданных = Метаданные.НайтиПоТипу(ТипЗнч(СтрокаДокумента.Ссылка));
	Если ОбъектМетаданных = Неопределено Тогда
		ВызватьИсключение "LATEST_DOCUMENT_METADATA_FAILED";
	КонецЕсли;
	Результат = Новый Структура;
	Результат.Вставить("metadata", Строка(ОбъектМетаданных.ПолноеИмя()));
	Результат.Вставить("synonym", Строка(ОбъектМетаданных.Синоним));
	Результат.Вставить("presentation", Строка(СтрокаДокумента.Ссылка));
	Результат.Вставить("uuid", Строка(СтрокаДокумента.Ссылка.УникальныйИдентификатор()));
	Результат.Вставить("number", Строка(СтрокаДокумента.Номер));
	Результат.Вставить("date", XMLСтрока(СтрокаДокумента.Дата));
	Результат.Вставить("posted", СтрокаДокумента.Проведен);
	Результат.Вставить("deletion_mark", СтрокаДокумента.ПометкаУдаления);
	Возврат Результат;
КонецФункции

Процедура ДобавитьСовпаденияПоследнихДокументов(Строки, МаксимальнаяДата, УникальныеДокументы, ДокументыРезультата, Усечено)
	Для Каждого СтрокаДокумента Из Строки Цикл
		Если СтрокаДокумента.Дата <> МаксимальнаяДата Тогда
			Продолжить;
		КонецЕсли;
		ОписаниеДокумента = ОписатьПоследнийДокумент(СтрокаДокумента);
		КлючДокумента = ОписаниеДокумента.metadata + "|" + ОписаниеДокумента.uuid;
		Если УникальныеДокументы.Получить(КлючДокумента) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;
		УникальныеДокументы.Вставить(КлючДокумента, Истина);
		Если ДокументыРезультата.Количество() < 20 Тогда
			ДокументыРезультата.Добавить(ОписаниеДокумента);
		Иначе
			Усечено = Истина;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

Функция ПустаяТаблицаПоследнихДокументов()
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Ссылка");
	Результат.Колонки.Добавить("Номер");
	Результат.Колонки.Добавить("Дата");
	Результат.Колонки.Добавить("Проведен");
	Результат.Колонки.Добавить("ПометкаУдаления");
	Возврат Результат;
КонецФункции

Функция ПодготовитьФильтрыПоследнихДокументов(Параметры)
	Результат = Новый Структура;
	Результат.Вставить("responsible_set", Ложь);
	Результат.Вставить("responsible", Неопределено);
	Результат.Вставить("organization_set", Ложь);
	Результат.Вставить("organization", Неопределено);
	Результат.Вставить("posted_set", Ложь);
	Результат.Вставить("posted", Ложь);
	Результат.Вставить("date_from", Неопределено);
	Результат.Вставить("date_to", Неопределено);
	Если Параметры.Свойство("responsible") Тогда
		Описание = Новый Структура("type,metadata,uuid", "reference", Параметры.responsible.metadata, Параметры.responsible.uuid);
		Результат.responsible = ПреобразоватьПараметр(Описание);
		Результат.responsible_set = Истина;
	КонецЕсли;
	Если Параметры.Свойство("organization") Тогда
		Описание = Новый Структура("type,metadata,uuid", "reference", Параметры.organization.metadata, Параметры.organization.uuid);
		Результат.organization = ПреобразоватьПараметр(Описание);
		Результат.organization_set = Истина;
	КонецЕсли;
	Если Параметры.Свойство("posted") Тогда
		Если ТипЗнч(Параметры.posted) <> Тип("Булево") Тогда
			ВызватьИсключение "LATEST_DOCUMENT_FILTER_INVALID";
		КонецЕсли;
		Результат.posted = Параметры.posted;
		Результат.posted_set = Истина;
	КонецЕсли;
	Если Параметры.Свойство("date_from") И НЕ ПустаяСтрока(Параметры.date_from) Тогда
		Результат.date_from = XMLЗначение(Тип("Дата"), Параметры.date_from);
	КонецЕсли;
	Если Параметры.Свойство("date_to") И НЕ ПустаяСтрока(Параметры.date_to) Тогда
		Результат.date_to = XMLЗначение(Тип("Дата"), Параметры.date_to);
	КонецЕсли;
	Если Результат.date_from <> Неопределено И Результат.date_to <> Неопределено
		И Результат.date_from > Результат.date_to Тогда
		ВызватьИсключение "LATEST_DOCUMENT_DATE_INVALID";
	КонецЕсли;
	Возврат Результат;
КонецФункции

Функция ДокументПоддерживаетСсылочныйФильтр(ДокументМетаданных, ИмяРеквизита, ЗначениеФильтра)
	РеквизитМетаданных = ДокументМетаданных.Реквизиты.Найти(ИмяРеквизита);
	Если РеквизитМетаданных = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	Попытка
		Возврат РеквизитМетаданных.Тип.СодержитТип(ТипЗнч(ЗначениеФильтра));
	Исключение
		Возврат Ложь;
	КонецПопытки;
КонецФункции

Функция ВыполнитьФильтрованныйЗапросПоследнихДокументов(ДокументМетаданных, Фильтры, Лимит, МаксимальнаяДата, ИспользоватьПолеНомер, ИспользоватьПолеПроведен)
	Если Фильтры.posted_set И Фильтры.posted И НЕ ИспользоватьПолеПроведен Тогда
		Возврат ПустаяТаблицаПоследнихДокументов();
	КонецЕсли;
	ПредставлениеНомер = ?(ИспользоватьПолеНомер, "Источник.Номер", Символ(34) + Символ(34));
	ПредставлениеПроведен = ?(ИспользоватьПолеПроведен, "Источник.Проведен", "ЛОЖЬ");
	ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ " + Формат(Лимит, "ЧГ=0") + Символы.ПС
		+ " Источник.Ссылка КАК Ссылка," + Символы.ПС
		+ " " + ПредставлениеНомер + " КАК Номер," + Символы.ПС
		+ " Источник.Дата КАК Дата," + Символы.ПС
		+ " " + ПредставлениеПроведен + " КАК Проведен," + Символы.ПС
		+ " Источник.ПометкаУдаления КАК ПометкаУдаления" + Символы.ПС
		+ "ИЗ Документ." + ДокументМетаданных.Имя + " КАК Источник" + Символы.ПС
		+ "ГДЕ НЕ Источник.ПометкаУдаления";
	Если МаксимальнаяДата <> Неопределено Тогда
		ТекстЗапроса = ТекстЗапроса + Символы.ПС + " И Источник.Дата = &МаксимальнаяДата";
	Иначе
		Если Фильтры.date_from <> Неопределено Тогда
			ТекстЗапроса = ТекстЗапроса + Символы.ПС + " И Источник.Дата >= &ДатаНачала";
		КонецЕсли;
		Если Фильтры.date_to <> Неопределено Тогда
			ТекстЗапроса = ТекстЗапроса + Символы.ПС + " И Источник.Дата <= &ДатаОкончания";
		КонецЕсли;
	КонецЕсли;
	Если Фильтры.posted_set И ИспользоватьПолеПроведен Тогда
		ТекстЗапроса = ТекстЗапроса + Символы.ПС + " И Источник.Проведен = &Проведен";
	КонецЕсли;
	Если Фильтры.responsible_set Тогда
		ТекстЗапроса = ТекстЗапроса + Символы.ПС + " И Источник.Ответственный = &Ответственный";
	КонецЕсли;
	Если Фильтры.organization_set Тогда
		ТекстЗапроса = ТекстЗапроса + Символы.ПС + " И Источник.Организация = &Организация";
	КонецЕсли;
	ТекстЗапроса = ТекстЗапроса + Символы.ПС + "УПОРЯДОЧИТЬ ПО Источник.Дата УБЫВ";
	Запрос1С = Новый Запрос(ТекстЗапроса);
	Если МаксимальнаяДата <> Неопределено Тогда
		Запрос1С.УстановитьПараметр("МаксимальнаяДата", МаксимальнаяДата);
	Иначе
		Если Фильтры.date_from <> Неопределено Тогда
			Запрос1С.УстановитьПараметр("ДатаНачала", Фильтры.date_from);
		КонецЕсли;
		Если Фильтры.date_to <> Неопределено Тогда
			Запрос1С.УстановитьПараметр("ДатаОкончания", Фильтры.date_to);
		КонецЕсли;
	КонецЕсли;
	Если Фильтры.posted_set И ИспользоватьПолеПроведен Тогда
		Запрос1С.УстановитьПараметр("Проведен", Фильтры.posted);
	КонецЕсли;
	Если Фильтры.responsible_set Тогда
		Запрос1С.УстановитьПараметр("Ответственный", Фильтры.responsible);
	КонецЕсли;
	Если Фильтры.organization_set Тогда
		Запрос1С.УстановитьПараметр("Организация", Фильтры.organization);
	КонецЕсли;
	Возврат Запрос1С.Выполнить().Выгрузить();
КонецФункции

Функция ПолучитьФильтрованныеСтрокиПоследнихДокументов(ДокументМетаданных, Фильтры, Лимит, МаксимальнаяДата = Неопределено)
	Попытка
		Возврат ВыполнитьФильтрованныйЗапросПоследнихДокументов(ДокументМетаданных, Фильтры, Лимит, МаксимальнаяДата, Истина, Истина);
	Исключение
		Попытка
			Возврат ВыполнитьФильтрованныйЗапросПоследнихДокументов(ДокументМетаданных, Фильтры, Лимит, МаксимальнаяДата, Ложь, Истина);
		Исключение
			Попытка
				Возврат ВыполнитьФильтрованныйЗапросПоследнихДокументов(ДокументМетаданных, Фильтры, Лимит, МаксимальнаяДата, Истина, Ложь);
			Исключение
				Возврат ВыполнитьФильтрованныйЗапросПоследнихДокументов(ДокументМетаданных, Фильтры, Лимит, МаксимальнаяДата, Ложь, Ложь);
			КонецПопытки;
		КонецПопытки;
	КонецПопытки;
КонецФункции

Функция ВыполнитьФильтрованныйПоискПоследнихДокументов(Параметры)
	НачалоВыполнения = ТекущаяДата();
	Попытка
		ФильтрыЗапроса = ПодготовитьФильтрыПоследнихДокументов(Параметры);
	Исключение
		Возврат ОтветОшибка(400, "LATEST_DOCUMENT_FILTER_INVALID", "Latest-document filters are invalid.");
	КонецПопытки;
	Попытка
		ДоступныеДокументы = ДоступныеДокументыДляПоследнего();
		Если ДоступныеДокументы.Количество() > 1000 Тогда
			Возврат ОтветОшибка(503, "LATEST_DOCUMENT_TOO_MANY_TYPES", "More than 1000 readable document types are not supported.");
		КонецЕсли;
		ПокрытыеДокументы = Новый Соответствие;
		Источники = Новый Массив;
		Для Каждого ЭлементДокумента Из ДоступныеДокументы Цикл
			ПроверитьБюджетПоследнихДокументов(НачалоВыполнения);
			ДокументМетаданных = ЭлементДокумента.Значение;
			Если ФильтрыЗапроса.responsible_set
				И НЕ ДокументПоддерживаетСсылочныйФильтр(ДокументМетаданных, "Ответственный", ФильтрыЗапроса.responsible) Тогда
				ПокрытыеДокументы.Вставить(ЭлементДокумента.Ключ, Истина);
				Продолжить;
			КонецЕсли;
			Если ФильтрыЗапроса.organization_set
				И НЕ ДокументПоддерживаетСсылочныйФильтр(ДокументМетаданных, "Организация", ФильтрыЗапроса.organization) Тогда
				ПокрытыеДокументы.Вставить(ЭлементДокумента.Ключ, Истина);
				Продолжить;
			КонецЕсли;
			Строки = ПолучитьФильтрованныеСтрокиПоследнихДокументов(ДокументМетаданных, ФильтрыЗапроса, 1);
			ИменаДокументов = Новый Массив;
			ИменаДокументов.Добавить(ЭлементДокумента.Ключ);
			ЗарегистрироватьИсточникПоиска(Источники, "document", "Документ." + ЭлементДокумента.Ключ, ИменаДокументов, Строки);
			ПокрытыеДокументы.Вставить(ЭлементДокумента.Ключ, Истина);
		КонецЦикла;
		Если ПокрытыеДокументы.Количество() <> ДоступныеДокументы.Количество() Тогда
			ВызватьИсключение "LATEST_DOCUMENT_INCOMPLETE";
		КонецЕсли;
		МаксимальнаяДата = Неопределено;
		Для Каждого Источник Из Источники Цикл
			Если Источник.top_date <> Неопределено
				И (МаксимальнаяДата = Неопределено ИЛИ Источник.top_date > МаксимальнаяДата) Тогда
				МаксимальнаяДата = Источник.top_date;
			КонецЕсли;
		КонецЦикла;
		ДокументыРезультата = Новый Массив;
		УникальныеДокументы = Новый Соответствие;
		Усечено = Ложь;
		Если МаксимальнаяДата <> Неопределено Тогда
			Для Каждого Источник Из Источники Цикл
				Если Источник.top_date <> МаксимальнаяДата Тогда
					Продолжить;
				КонецЕсли;
				ПроверитьБюджетПоследнихДокументов(НачалоВыполнения);
				ДокументМетаданных = ДоступныеДокументы.Получить(Источник.documents[0]);
				Строки = ПолучитьФильтрованныеСтрокиПоследнихДокументов(ДокументМетаданных, ФильтрыЗапроса, 21, МаксимальнаяДата);
				ДобавитьСовпаденияПоследнихДокументов(Строки, МаксимальнаяДата, УникальныеДокументы, ДокументыРезультата, Усечено);
			КонецЦикла;
		КонецЕсли;
		ФильтрыРезультата = Новый Массив;
		ФильтрыРезультата.Добавить("ПометкаУдаления = Ложь");
		Результат = Новый Структура;
		Результат.Вставить("documents", ДокументыРезультата);
		Результат.Вставить("max_date", ?(МаксимальнаяДата = Неопределено, "", XMLСтрока(МаксимальнаяДата)));
		Результат.Вставить("returned_count", ДокументыРезультата.Количество());
		Результат.Вставить("truncated", Усечено);
		Результат.Вставить("readable_document_types", ДоступныеДокументы.Количество());
		Результат.Вставить("scanned_document_types", ПокрытыеДокументы.Количество());
		Результат.Вставить("complete", Истина);
		Результат.Вставить("filters", ФильтрыРезультата);
		Результат.Вставить("execution_ms", (ТекущаяДата() - НачалоВыполнения) * 1000);
		Результат.Вставить("data_is_untrusted", Истина);
		Возврат ОтветJSON(Результат);
	Исключение
		Если СтрНайти(ОписаниеОшибки(), "LATEST_DOCUMENT_TIMEOUT") > 0 Тогда
			Возврат ОтветОшибка(503, "LATEST_DOCUMENT_TIMEOUT", "The filtered global document scan exceeded 20 seconds.");
		КонецЕсли;
		Возврат ОтветОшибка(503, "LATEST_DOCUMENT_INCOMPLETE", "The filtered global document scan could not confirm full coverage.");
	КонецПопытки;
КонецФункции

Функция ПоследниеДокументыPOST(HTTPЗапрос)
	Попытка
		Параметры = ПрочитатьТелоJSON(HTTPЗапрос);
	Исключение
		Возврат ОтветОшибка(400, "INVALID_JSON", "Request body must be valid JSON.");
	КонецПопытки;
	Возврат ВыполнитьФильтрованныйПоискПоследнихДокументов(Параметры);
КонецФункции

Функция ПоследниеДокументыGET(HTTPЗапрос)
	НачалоВыполнения = ТекущаяДата();
	Попытка
		ДоступныеДокументы = ДоступныеДокументыДляПоследнего();
		Если ДоступныеДокументы.Количество() > 1000 Тогда
			Возврат ОтветОшибка(503, "LATEST_DOCUMENT_TOO_MANY_TYPES", "More than 1000 readable document types are not supported.");
		КонецЕсли;
		ПокрытыеДокументы = Новый Соответствие;
		Источники = Новый Массив;

		Для Каждого ЖурналМетаданных Из Метаданные.ЖурналыДокументов Цикл
			ПроверитьБюджетПоследнихДокументов(НачалоВыполнения);
			Если НЕ ПользовательМожетЧитать(ЖурналМетаданных) Тогда
				Продолжить;
			КонецЕсли;
			ИменаДокументов = НепокрытыеДокументыЖурнала(ЖурналМетаданных, ДоступныеДокументы, ПокрытыеДокументы);
			Если ИменаДокументов.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			Попытка
				ИсточникЗапроса = "ЖурналДокументов." + ЖурналМетаданных.Имя;
				Строки = ПолучитьСтрокиПоследнихДокументов(ИсточникЗапроса, 1);
				ЗарегистрироватьИсточникПоиска(Источники, "journal", ИсточникЗапроса, ИменаДокументов, Строки);
				Для Каждого ИмяДокумента Из ИменаДокументов Цикл
					ПокрытыеДокументы.Вставить(ИмяДокумента, Истина);
				КонецЦикла;
			Исключение
				// Ошибка журнала безопасно переводит его документы на индивидуальную проверку.
			КонецПопытки;
		КонецЦикла;

		Для Каждого ЭлементДокумента Из ДоступныеДокументы Цикл
			ПроверитьБюджетПоследнихДокументов(НачалоВыполнения);
			Если ПокрытыеДокументы.Получить(ЭлементДокумента.Ключ) <> Неопределено Тогда
				Продолжить;
			КонецЕсли;
			ИсточникЗапроса = "Документ." + ЭлементДокумента.Ключ;
			ИменаДокументов = Новый Массив;
			ИменаДокументов.Добавить(ЭлементДокумента.Ключ);
			Попытка
				Строки = ПолучитьСтрокиПоследнихДокументов(ИсточникЗапроса, 1);
			Исключение
				ВызватьИсключение "LATEST_DOCUMENT_SOURCE_FAILED";
			КонецПопытки;
			ЗарегистрироватьИсточникПоиска(Источники, "document", ИсточникЗапроса, ИменаДокументов, Строки);
			ПокрытыеДокументы.Вставить(ЭлементДокумента.Ключ, Истина);
		КонецЦикла;

		Если ПокрытыеДокументы.Количество() <> ДоступныеДокументы.Количество() Тогда
			Возврат ОтветОшибка(503, "LATEST_DOCUMENT_INCOMPLETE", "Not all readable document types were scanned.");
		КонецЕсли;
		МаксимальнаяДата = Неопределено;
		Для Каждого Источник Из Источники Цикл
			Если Источник.top_date <> Неопределено
				И (МаксимальнаяДата = Неопределено ИЛИ Источник.top_date > МаксимальнаяДата) Тогда
				МаксимальнаяДата = Источник.top_date;
			КонецЕсли;
		КонецЦикла;

		ДокументыРезультата = Новый Массив;
		УникальныеДокументы = Новый Соответствие;
		Усечено = Ложь;
		Если МаксимальнаяДата <> Неопределено Тогда
			Для Каждого Источник Из Источники Цикл
				Если Источник.top_date <> МаксимальнаяДата Тогда
					Продолжить;
				КонецЕсли;
				ПроверитьБюджетПоследнихДокументов(НачалоВыполнения);
				Попытка
					Строки = ПолучитьСтрокиПоследнихДокументов(Источник.query_source, 21, МаксимальнаяДата);
					ДобавитьСовпаденияПоследнихДокументов(Строки, МаксимальнаяДата, УникальныеДокументы, ДокументыРезультата, Усечено);
				Исключение
					Если Источник.kind <> "journal" Тогда
						ВызватьИсключение "LATEST_DOCUMENT_SOURCE_FAILED";
					КонецЕсли;
					Для Каждого ИмяДокумента Из Источник.documents Цикл
						ПроверитьБюджетПоследнихДокументов(НачалоВыполнения);
						Строки = ПолучитьСтрокиПоследнихДокументов("Документ." + ИмяДокумента, 21, МаксимальнаяДата);
						ДобавитьСовпаденияПоследнихДокументов(Строки, МаксимальнаяДата, УникальныеДокументы, ДокументыРезультата, Усечено);
					КонецЦикла;
				КонецПопытки;
			КонецЦикла;
		КонецЕсли;

		Фильтры = Новый Массив;
		Фильтры.Добавить("ПометкаУдаления = Ложь");
		Результат = Новый Структура;
		Результат.Вставить("documents", ДокументыРезультата);
		Если МаксимальнаяДата <> Неопределено Тогда
			Результат.Вставить("max_date", XMLСтрока(МаксимальнаяДата));
		Иначе
			Результат.Вставить("max_date", "");
		КонецЕсли;
		Результат.Вставить("returned_count", ДокументыРезультата.Количество());
		Результат.Вставить("truncated", Усечено);
		Результат.Вставить("readable_document_types", ДоступныеДокументы.Количество());
		Результат.Вставить("scanned_document_types", ПокрытыеДокументы.Количество());
		Результат.Вставить("complete", Истина);
		Результат.Вставить("filters", Фильтры);
		Результат.Вставить("execution_ms", (ТекущаяДата() - НачалоВыполнения) * 1000);
		Результат.Вставить("data_is_untrusted", Истина);
		Возврат ОтветJSON(Результат);
	Исключение
		Если СтрНайти(ОписаниеОшибки(), "LATEST_DOCUMENT_TIMEOUT") > 0 Тогда
			Возврат ОтветОшибка(503, "LATEST_DOCUMENT_TIMEOUT", "The global document scan exceeded 20 seconds.");
		КонецЕсли;
		Возврат ОтветОшибка(503, "LATEST_DOCUMENT_INCOMPLETE", "The global document scan could not confirm full coverage.");
	КонецПопытки;
КонецФункции

Функция ТабличнаяЧастьДокументаPOST(HTTPЗапрос)
	НачалоВыполнения = ТекущаяДата();
	Попытка
		Параметры = ПрочитатьТелоJSON(HTTPЗапрос);
	Исключение
		Возврат ОтветОшибка(400, "INVALID_JSON", "Request body must be valid JSON.");
	КонецПопытки;
	Если НЕ Параметры.Свойство("document_type") ИЛИ НЕ Параметры.Свойство("uuid")
		ИЛИ НЕ Параметры.Свойство("table_part") Тогда
		Возврат ОтветОшибка(400, "TABLE_PART_REQUEST_INVALID", "document_type, uuid and table_part are required.");
	КонецЕсли;
	ЧастиТипа = СтрРазделить(Параметры.document_type, ".");
	Если ЧастиТипа.Количество() <> 2 ИЛИ ЧастиТипа[0] <> "Document" Тогда
		Возврат ОтветОшибка(400, "DOCUMENT_TYPE_INVALID", "document_type must use Document.Name form.");
	КонецЕсли;
	ДокументМетаданных = НайтиОбъектМетаданных("Document", ЧастиТипа[1]);
	Если ДокументМетаданных = Неопределено ИЛИ НЕ ПользовательМожетЧитать(ДокументМетаданных) Тогда
		Возврат ОтветОшибка(403, "DOCUMENT_FORBIDDEN", "Document type is absent or not readable.");
	КонецЕсли;
	ТабличнаяЧастьМетаданных = ДокументМетаданных.ТабличныеЧасти.Найти(Параметры.table_part);
	Если ТабличнаяЧастьМетаданных = Неопределено Тогда
		Возврат ОтветОшибка(403, "TABLE_PART_FORBIDDEN", "Table part is absent or not readable.");
	КонецЕсли;
	Лимит = 100;
	Если Параметры.Свойство("limit") Тогда
		Лимит = Параметры.limit;
	КонецЕсли;
	Если Лимит < 1 ИЛИ Лимит > 200 Тогда
		Возврат ОтветОшибка(400, "TABLE_PART_LIMIT_INVALID", "limit must be from 1 to 200.");
	КонецЕсли;
	Попытка
		ИдентификаторДокумента = Новый УникальныйИдентификатор(Параметры.uuid);
		СсылкаДокумента = Документы[ДокументМетаданных.Имя].ПолучитьСсылку(ИдентификаторДокумента);
	Исключение
		Возврат ОтветОшибка(400, "DOCUMENT_UUID_INVALID", "uuid must be a canonical document UUID.");
	КонецПопытки;
	ПоляЗапроса = " Источник.НомерСтроки КАК НомерСтроки";
	Для Каждого РеквизитМетаданных Из ТабличнаяЧастьМетаданных.Реквизиты Цикл
		ПоляЗапроса = ПоляЗапроса + "," + Символы.ПС
			+ " Источник." + РеквизитМетаданных.Имя + " КАК " + РеквизитМетаданных.Имя;
	КонецЦикла;
	ТекстЗапроса = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ " + Формат(Лимит + 1, "ЧГ=0") + Символы.ПС
		+ ПоляЗапроса + Символы.ПС
		+ "ИЗ Документ." + ДокументМетаданных.Имя + "." + ТабличнаяЧастьМетаданных.Имя + " КАК Источник" + Символы.ПС
		+ "ГДЕ Источник.Ссылка = &СсылкаДокумента" + Символы.ПС
		+ "УПОРЯДОЧИТЬ ПО Источник.НомерСтроки";
	Попытка
		Запрос1С = Новый Запрос(ТекстЗапроса);
		Запрос1С.УстановитьПараметр("СсылкаДокумента", СсылкаДокумента);
		РезультатЗапроса = Запрос1С.Выполнить();
	Исключение
		Возврат ОтветОшибка(403, "TABLE_PART_READ_FAILED", "The table part is absent or not readable for the current user.");
	КонецПопытки;
	Колонки = Новый Массив;
	Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
		ОписаниеКолонки = Новый Структура;
		ОписаниеКолонки.Вставить("name", Колонка.Имя);
		ТипКолонки = "";
		Попытка
			ТипКолонки = Строка(Колонка.ТипЗначения);
		Исключение
		КонецПопытки;
		ОписаниеКолонки.Вставить("type", ТипКолонки);
		Колонки.Добавить(ОписаниеКолонки);
	КонецЦикла;
	Строки = Новый Массив;
	Выборка = РезультатЗапроса.Выбрать();
	Усечено = Ложь;
	Пока Выборка.Следующий() Цикл
		Если Строки.Количество() >= Лимит Тогда
			Усечено = Истина;
			Прервать;
		КонецЕсли;
		СтрокаРезультата = Новый Структура;
		Для Каждого Колонка Из РезультатЗапроса.Колонки Цикл
			СтрокаРезультата.Вставить(Колонка.Имя, ПривестиЗначениеКJSON(Выборка[Колонка.Имя]));
		КонецЦикла;
		Строки.Добавить(СтрокаРезультата);
	КонецЦикла;
	Фильтры = Новый Массив;
	Фильтры.Добавить("Ссылка = document UUID");
	Результат = Новый Структура;
	Результат.Вставить("document_type", Параметры.document_type);
	Результат.Вставить("uuid", НРег(Строка(ИдентификаторДокумента)));
	Результат.Вставить("table_part", ТабличнаяЧастьМетаданных.Имя);
	Результат.Вставить("columns", Колонки);
	Результат.Вставить("rows", Строки);
	Результат.Вставить("returned_count", Строки.Количество());
	Результат.Вставить("limit", Лимит);
	Результат.Вставить("truncated", Усечено);
	Результат.Вставить("filters", Фильтры);
	Результат.Вставить("execution_ms", (ТекущаяДата() - НачалоВыполнения) * 1000);
	Результат.Вставить("data_is_untrusted", Истина);
	Возврат ОтветJSON(Результат);
КонецФункции

Функция ЗапросPOST(HTTPЗапрос)
	НачалоВыполнения = ТекущаяДата();
	Попытка
		Параметры = ПрочитатьТелоJSON(HTTPЗапрос);
	Исключение
